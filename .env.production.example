# Copy this to .env.production and fill in every required value.
# Keep this file private. Do not commit your completed .env.production.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-domain.example
POSTGRES_PASSWORD=
POSTGRES_DB=tanaspace
POSTGRES_USER=tanaspace

# An absolute directory containing fullchain.pem and privkey.pem.
TLS_CERT_DIR=/absolute/path/to/certificates
PUBLIC_HTTPS_PORT=443

DEMO_ACCOUNT_TTL_SECONDS=3600
DEMO_MAX_ACTIVE_USERS=25
GUNICORN_WORKERS=2
DJANGO_HSTS_SECONDS=3600
