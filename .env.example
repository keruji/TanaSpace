# Docker Compose reads this automatically after copying to .env.
# For native development, export variables in your terminal if needed.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Local development only. Set a unique secret before any deployment.
DJANGO_SECRET_KEY=django-insecure-tanaspace-local-development-only
# Set a long random password. Keep .env out of version control.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=tanaspace
POSTGRES_USER=tanaspace
# Demo accounts expire after one hour; cleanup runs every five minutes.
DEMO_ACCOUNT_TTL_SECONDS=3600
DEMO_MAX_ACTIVE_USERS=25
